# Bu dosyayı .env adıyla kopyalayın ve değerleri doldurun. .env dosyası git'e GÖNDERİLMEZ.

# fake | openai | gemini   (fake: ağa çıkmaz, testler ve demo için)
NEARSWAP_AI_PROVIDER=fake

OPENAI_API_KEY=
GEMINI_API_KEY=

