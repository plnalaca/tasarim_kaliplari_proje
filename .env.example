# Bu dosyayı .env adıyla kopyalayın ve değerleri doldurun. .env dosyası git'e GÖNDERİLMEZ.

# fake | openai | gemini   (fake: ağa çıkmaz, testler ve demo için)
NEARSWAP_AI_PROVIDER=fake

OPENAI_API_KEY=
GEMINI_API_KEY=

# İsteğe bağlı: model adını değiştirmek için
# NEARSWAP_OPENAI_MODEL=gpt-4o-mini
# NEARSWAP_GEMINI_MODEL=gemini-3.8-flash
# Gemini'nin düşünme düzeyi: low | medium | high (varsayılan: low; düşük = hızlı yanıt)
# NEARSWAP_GEMINI_THINKING=low

# İsteğe bağlı: ilanların ve fotoğrafların kaydedileceği klasör (varsayılan: data)
# NEARSWAP_DATA_DIR=data
